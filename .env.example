# ==============================================================================
# VulnTrace Studio — Optional Configuration Template
# ==============================================================================
# VulnTrace is LOCAL-FIRST and API-OPTIONAL.
# The core application operates 100% locally with ZERO API keys required:
#   - Deterministic AST codemods
#   - Rootless container reproduction & verification
#   - Cryptographic evidence generation & signing
#
# You do NOT need to create a .env file or configure any API keys to use VulnTrace.
# ==============================================================================

# Optional: NVIDIA Nemotron 3 Ultra (via Nebius Token Factory)
# If provided, enables the optional cloud LLM remediation engine (requires explicit per-run opt-in).
# Default: Unset (Pure local deterministic AST codemods).
# NEBIUS_API_KEY="your_nebius_api_key_here"
# NEBIUS_PROJECT_ID="your_nebius_project_id_here"

# Optional: Tavily Threat Intelligence
# If provided, enables live CVE search and exploit advisory retrieval (requires explicit per-run opt-in).
# Default: Unset (Local OSV.dev and bundled advisory metadata).
# TAVILY_API_KEY="tvly-your_tavily_key_here"

# Server Host and Port Configuration
VULNTRACE_HOST="127.0.0.1"
VULNTRACE_PORT=8000
